# ===================================================================
# RiTiVerse Salon & Aesthetics - Production Environment Configuration
# Copy this file to .env on your cPanel server (NEVER commit .env)
# ===================================================================

# Environment
APP_ENV=production
APP_URL=https://yourdomain.com

# Database Connection (Enter your cPanel MySQL Database details)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_salondb
DB_USER=cpaneluser_salonusr
DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD

# JWT Secret (Generate a unique 64-char random hex string via: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Optional CORS Allowed Origins (comma-separated, leave blank for strict same-origin)
CORS_ALLOWED_ORIGINS=

# Optional Payment Gateway Overrides (Can also be managed via Admin UI)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_SECRET=

# Optional Meta CAPI Secret Token (Kept strictly on PHP server)
META_CAPI_TOKEN=
