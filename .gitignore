# Dependencies & build artifacts (root /index.html & /assets/ stay tracked for zero-Node cPanel Git deploys)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
cpanel_deploy/
*.local

# Environment & generated secrets
.env
.env.*
!.env.example
api/config/.jwt_secret

# Local development SQLite databases & backups
database/*.sqlite
database/*.sqlite-*
database/*.db
*.sqlite
*.sqlite3

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/

# OS & editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
